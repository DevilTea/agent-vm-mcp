[Unit]
Description=Loopback-only VNC view of the Agent VM browser display
Wants=agent-browser-x.service
After=agent-browser-x.service

[Service]
Type=simple
User=@AGENT_USER@
Group=@AGENT_GROUP@
Environment=DISPLAY=:99
ExecStart=/usr/bin/x11vnc -display :99 -no6 -rfbportv6 0 -listen 127.0.0.1 -rfbport 5900 -forever -shared -nopw -noxdamage
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
