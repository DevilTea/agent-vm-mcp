{
  "version": 1,
  "directExecutableDirs": [
    "@HOME@/.local/bin",
    "/usr/local/bin"
  ],
  "aliases": {
    "@openai/codex": "codex",
    "npm:@openai/codex": "codex",
    "@anthropic-ai/claude-code": "claude",
    "npm:@anthropic-ai/claude-code": "claude",
    "playwright-mcp-agent": "playwright-mcp"
  },
  "latestSources": {
    "agy": {
      "kind": "github-release",
      "repo": "google-antigravity/antigravity-cli",
      "stripPrefix": "v"
    },
    "gh": {
      "kind": "github-release",
      "repo": "cli/cli",
      "stripPrefix": "v"
    },
    "node": {
      "kind": "mise",
      "tool": "node@24"
    },
    "pnpm": {
      "kind": "mise",
      "tool": "pnpm@11"
    }
  },
  "installations": [],
  "services": [],
  "repositories": [],
  "projects": [],
  "coverage": {
    "managedElsewhere": {}
  }
}
