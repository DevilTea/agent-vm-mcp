[Unit]
Description=Loopback-only noVNC proxy for Agent VM browser takeover
Wants=agent-browser-vnc.service
After=agent-browser-vnc.service

[Service]
Type=simple
User=@AGENT_USER@
Group=@AGENT_GROUP@
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
