{
  "version": 1,
  "capabilitiesPath": "/opt/agent-mcp/config/capabilities.json",
  "directExecutableDirs": [
    "@HOME@/.local/bin",
    "/usr/local/bin"
  ],
  "aliases": {
    "@openai/codex": "codex",
    "npm:@openai/codex": "codex",
    "@anthropic-ai/claude-code": "claude",
    "npm:@anthropic-ai/claude-code": "claude",
    "playwright-mcp-agent": "playwright-mcp"
  },
  "latestSources": {
    "agy": {
      "kind": "github-release",
      "repo": "google-antigravity/antigravity-cli",
      "stripPrefix": "v"
    },
    "gh": {
      "kind": "github-release",
      "repo": "cli/cli",
      "stripPrefix": "v"
    },
    "node": {
      "kind": "mise",
      "tool": "node@24"
    },
    "pnpm": {
      "kind": "mise",
      "tool": "pnpm@11"
    },
    "mise": {
      "kind": "github-release",
      "repo": "jdx/mise",
      "stripPrefix": "v"
    },
    "tailscale": {
      "kind": "github-release",
      "repo": "tailscale/tailscale",
      "stripPrefix": "v"
    }
  },
  "installations": [
    {
      "id": "playwright-mcp",
      "kind": "npm-project",
      "root": "/opt/playwright-mcp",
      "package": "@playwright/mcp"
    },
    {
      "id": "tailscale",
      "kind": "command",
      "command": "tailscale",
      "args": [
        "version"
      ],
      "managedBy": "apt/system"
    },
    {
      "id": "tunnel-client",
      "kind": "command",
      "command": "tunnel-client",
      "args": [
        "--version"
      ]
    }
  ],
  "services": [
    "agent-tunnel.service",
    "agent-herdr.service",
    "agent-playwright-shared.service",
    "tailscaled.service"
  ],
  "repositories": [
    {
      "id": "agent-vm-mcp-source",
      "path": "/home/agent/projects/DevilTea/agent-vm-mcp",
      "branch": "main"
    },
    {
      "id": "agent-vm-mcp-deploy",
      "path": "/opt/agent-mcp",
      "branch": "main"
    },
    {
      "id": "dot-agents",
      "path": "/home/agent/projects/DevilTea/dot-agents",
      "branch": "main"
    }
  ],
  "projects": [
    {
      "id": "agent-vm-mcp",
      "path": "/home/agent/projects/DevilTea/agent-vm-mcp",
      "packageManager": "pnpm"
    }
  ],
  "coverage": {
    "managedElsewhere": {
      "dot-agents": "Repository freshness is reported under repositories instead of semantic-version lookup."
    }
  }
}
