{
  "version": 1,
  "bridges": [
    {
      "id": "playwright",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "command": "/opt/playwright-mcp/start.sh",
        "args": []
      },
      "toolPrefix": "",
      "includeTools": [
        "browser_*"
      ],
      "toolAdapters": {
        "browser_take_screenshot": {
          "type": "output-directory-artifact",
          "outputDir": "/home/agent/.local/share/playwright-mcp/output",
          "extensions": [
            ".png",
            ".jpg",
            ".jpeg",
            ".webp"
          ],
          "pathArgument": "filename",
          "workingDir": "/opt/playwright-mcp",
          "mimeTypeArgument": "type",
          "mimeTypeMap": {
            "png": "image/png",
            "jpeg": "image/jpeg",
            "webp": "image/webp"
          }
        }
      }
    }
  ]
}
